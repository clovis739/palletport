# Postgres (Neon). Pooled URL for the app, direct URL for `prisma db push`. See DEPLOY.md.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Photo storage for uploads on the live site (leave empty locally: files then go to ./uploads).
# Cloudinary (recommended, free plan): copy "API environment variable" from the Cloudinary dashboard.
CLOUDINARY_URL="CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@qsspd7ni"
# Optional folder inside your Cloudinary media library (default: palletport).
# CLOUDINARY_FOLDER="palletport"
# Alternative on Vercel only: Vercel Blob (set automatically when you add a Blob store).
BLOB_READ_WRITE_TOKEN=""
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Resend: use a sending-access API key restricted to your verified domain.

# Password reset links require your public site URL (e.g. https://liquidationpalletssale.com).
# Public site URL for production, e.g. https://www.yourdomain.com. Optional: when unset the URL is detected
# automatically (Vercel/Netlify/Render/Railway/Fly variables, then the request host, then the dev port).
# APP_URL="https://www.yourdomain.com"

# --- Site state & security ---
# Set to 1 to show the maintenance screen (HTTP 503) to everyone.
MAINTENANCE_MODE="0"
MAINTENANCE_MESSAGE="We expect to be back within the hour."
# Visit any page with ?bypass=<this value> to browse during maintenance.
MAINTENANCE_BYPASS=""
# Production redirects http:// to https:// (set to 0 only if your host already does it).
FORCE_HTTPS="1"

# Google Business Profile (optional). Place ID + profile link are set in Admin → Site settings → Business profile.
# Places API (New) key: shows your live Google rating and reviews. Restrict it to the Places API.
GOOGLE_PLACES_API_KEY=
# Maps Embed API key for the warehouse map (free). Restrict it to your domain. Without it a keyless map embed is used.
GOOGLE_MAPS_EMBED_KEY=

# Google Search Console "HTML tag" verification code (or set it in Admin → Site settings → SEO defaults).
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID, e.g. G-AB12CD34EF (or set it in Admin → Site settings → SEO defaults).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Smartsupp live chat key (or set it in Admin → Site settings → Business profile → Live chat).
NEXT_PUBLIC_SMARTSUPP_KEY=
